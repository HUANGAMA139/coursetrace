# Keep the real key in your environment or the ignored .env.local file.
DASHSCOPE_API_KEY=
# Default gateway: China (Beijing). For another region use that region's key and endpoint.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_HTTP_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# If your account requires a workspace endpoint, replace both URLs with its official URLs.
QWEN_CHAT_MODEL=qwen3.7-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1024
QWEN_ASR_MODEL=qwen-audio-3.1-asr-flash-filetrans
# Official public sample. No user course file is uploaded by the M0 smoke test.
QWEN_ASR_AUDIO_URL=https://dashscope.oss-cn-beijing.aliyuncs.com/samples/audio/paraformer/hello_world_female2.wav
# Optional: override JAVA_HOME with your own JDK directory.
COURSETRACE_JAVA_HOME=
# Generated locally by scripts/prepare-local.ps1; never put real values in this example.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MINIO_ROOT_PASSWORD=

# M2 local object storage and video limits. Existing local MinIO password stays private.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_VIDEO_BUCKET=coursetrace-videos
VIDEO_MAX_UPLOAD_SIZE=500MB
VIDEO_MAX_REQUEST_SIZE=510MB
FFPROBE_PATH=.tools/ffmpeg/ffmpeg-9.0.2-essentials_build/bin/ffprobe.exe

# M3 local asynchronous processing. Real credentials remain in local environment.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
PROCESSING_ENABLED=true
PROCESSING_PUBLISHER_ENABLED=true
PROCESSING_MAX_PUBLISH_ATTEMPTS=20
# M4 media tools and processing admission. Existing QWEN settings above are reused.
FFMPEG_PATH=.tools/ffmpeg/ffmpeg-9.0.2-essentials_build/bin/ffmpeg.exe
LEARNING_MAX_DURATION_SECONDS=3600
# M5 retrieval; keys remain in local environment only.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=coursetrace_segments_te4_1024_v1
SEARCH_TARGET_CHARS=800
SEARCH_MAX_CHARS=1200
SEARCH_MAX_BYTES=6000
SEARCH_OVERLAP_CHARS=160
SEARCH_BATCH_SIZE=10
SEARCH_MAX_CHUNKS=200
SEARCH_TOP_K=6

# M6: lower these limits for controlled budget verification
AGENT_MAX_ROUNDS=4
AGENT_DEADLINE_SECONDS=120

# Resumable uploads and shared Redis admission
UPLOAD_CHUNK_BYTES=8388608
UPLOAD_EXPIRE_HOURS=24
UPLOAD_MAX_SESSIONS=3
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
RATE_LIMIT_ENABLED=true
RATE_QA_CAPACITY=2
RATE_QA_REFILL_SECONDS=10
RATE_GLOBAL_QA_CAPACITY=10
RATE_GLOBAL_QA_REFILL_SECONDS=1
RATE_LEARNING_CAPACITY=1
RATE_LEARNING_REFILL_SECONDS=60
RATE_INDEX_CAPACITY=2
RATE_INDEX_REFILL_SECONDS=30
RATE_GLOBAL_LEARNING_CAPACITY=3
RATE_GLOBAL_LEARNING_REFILL_SECONDS=20
RATE_GLOBAL_INDEX_CAPACITY=4
RATE_GLOBAL_INDEX_REFILL_SECONDS=10
